{
  "name": "@mossforge/databroker-mcp",
  "version": "0.4.2",
  "description": "MCP server for MossForge DataBroker - pay-per-call UK vehicle MOT history, MOT analytics, and identifier/reference-data utilities, paid via x402 USDC micropayments on Base. No API key, no account.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "base",
    "usdc",
    "micropayments",
    "mot",
    "dvsa",
    "uk",
    "vehicle-data",
    "open-data",
    "agent-tools"
  ],
  "homepage": "https://databroker.mossforge.dev",
  "bugs": {
    "url": "https://github.com/mossforge/databroker/issues",
    "email": "support@mossforge.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mossforge/databroker.git",
    "directory": "mcp-server"
  },
  "license": "MIT",
  "author": "Mossforge Ltd (https://mossforge.dev)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "databroker-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "mcpName": "dev.mossforge/databroker",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "version": "npm run sync-server-json && git add server.json",
    "sync-server-json": "node -e \"const fs=require('fs'),v=require('./package.json').version,s=JSON.parse(fs.readFileSync('server.json','utf8'));s.version=v;s.packages.forEach(p=>p.version=v);fs.writeFileSync('server.json',JSON.stringify(s,null,2)+'\\n')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/fetch": "^2.19.0",
    "viem": "^2.55.2",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@coinbase/cdp-sdk": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
